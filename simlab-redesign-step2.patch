+.slab .tgl:after{content:"";position:absolute;right:3px;top:3px;width:18px;height:18px;border-radius:50%;background:#fff}
+.slab .tgl.off{background:#232327}.slab .tgl.off:after{right:auto;left:3px;background:#8b8b95}
+.slab .runb{width:100%;height:50px;border-radius:14px;margin-top:24px;font-size:15px}
