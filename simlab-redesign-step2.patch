+/* ---- simulator pages (from the approved simulator mock) ---- */
+.slab .pgi{padding:20px 24px 40px}
+.slab .pgh{display:flex;align-items:flex-end;justify-content:space-between}
+.slab .pgh h2{margin:8px 0 0;font-size:34px;font-weight:500;letter-spacing:-1px}
+.slab .pgh .rr{display:flex;gap:10px}
+.slab .pgh .btn{height:44px;border-radius:12px;padding:0 20px;font-size:14px}
+.slab .g2{display:grid;grid-template-columns:400px minmax(0,1fr);gap:20px;margin-top:20px;align-items:start}
+.slab .panel{border:1px solid #17171a;border-radius:20px;background:#050506;padding:20px}
+.slab .panel h3{margin:0;font-size:16px;font-weight:500}
+.slab .panel .sub{font-size:12px;color:var(--muted);margin-top:3px}
+.slab .fld{margin-top:16px}
+.slab .fld label{display:block;font-size:12px;color:#a1a1aa;margin-bottom:8px}
+.slab .inp{height:42px;border:1px solid #232327;border-radius:12px;background:#0a0a0c;display:flex;align-items:center;justify-content:space-between;padding:0 14px;font-size:14px;color:#f5f5f7}
+.slab .inp span{font-size:12px;color:var(--muted)}
+.slab .hint{font-size:11px;color:#71717a;margin-top:6px}
+.slab .r2c{display:grid;grid-template-columns:1fr 1fr;gap:12px}
+.slab .chips{display:flex;flex-wrap:wrap;gap:8px}
+.slab .chp{height:34px;padding:0 14px;border:1px solid #232327;border-radius:10px;font-size:13px;color:#b4b4bd;display:flex;align-items:center;gap:6px;background:#0a0a0c;white-space:nowrap}
+.slab .chp.on{background:#1a1538;border-color:#3b2f7a;color:#e9e5ff}
+.slab .grp{margin-top:22px;padding-top:18px;border-top:1px solid #17171a}
+.slab .grp h4{margin:0;font-size:13px;font-weight:500;display:flex;align-items:center;gap:8px}
+.slab .grp h4 i{width:8px;height:8px;border-radius:50%;display:block}
+.slab .rng{display:flex;align-items:center;gap:14px;height:30px}
+.slab .rng .rt2{flex:1;position:relative;height:4px;background:#232327;border-radius:2px}
+.slab .rng .rf{position:absolute;left:0;top:0;bottom:0;background:#a78bfa;border-radius:2px}
+.slab .rng .rh{position:absolute;top:50%;width:18px;height:18px;border-radius:50%;background:#0a0a0a;border:3px solid #a78bfa;transform:translate(-50%,-50%)}
+.slab .rng b{font-size:14px;font-weight:500;min-width:54px;text-align:right}
+.slab .tgr{display:flex;align-items:center;justify-content:space-between;margin-top:14px;font-size:14px;color:#e4e4e7}
