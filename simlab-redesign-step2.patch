+.slab .drop{border:1px dashed #33333a;border-radius:14px;height:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#a1a1aa;font-size:13px;margin-top:14px;background:#08080a}
+.slab .lnk{display:flex;gap:16px;margin-top:12px;font-size:13px;color:#b9a7ff}
+.slab .lnk span{display:flex;align-items:center;gap:6px}
+.slab .seg3{display:flex;background:#0a0a0c;border:1px solid #1f1f23;border-radius:12px;padding:3px}
+.slab .seg3 button{flex:1;text-align:center;font-size:13px;padding:8px 0;border-radius:9px;color:#8b8b95}
+.slab .seg3 button.on{background:#1f1f23;color:#f5f5f7}
+.slab .tbl{width:100%;border-collapse:collapse;margin-top:14px;font-size:14px}
+.slab .tbl th{font-size:12px;font-weight:400;color:#8b8b95;text-align:left;padding:0 8px 10px 0}
+.slab .tbl td{padding:8px 8px 8px 0;border-top:1px solid #131316}
+.slab .tbl .ce{height:38px;border:1px solid #232327;border-radius:10px;background:#0a0a0c;display:flex;align-items:center;padding:0 12px;font-size:13px;color:#f5f5f7;width:100%}
+.slab .tbl .rl{display:flex;align-items:center;gap:10px;font-size:14px;color:#f5f5f7}
+.slab .tbl .rl i{width:10px;height:10px;border-radius:3px;display:block;flex:none}
+.slab .sel2{height:42px;border:1px solid #232327;border-radius:12px;background:#0a0a0c;display:flex;align-items:center;justify-content:space-between;padding:0 14px;font-size:14px;color:#d4d4d8}
+.slab .g3{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:20px;margin-top:20px;align-items:start}
+.slab .cols2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}
+
+/* ---- behaviour added on top of the mock (no visual change at rest) ---- */
+.slab .inp input,.slab .ce input,.slab .sel2 select{background:transparent;border:0;outline:0;color:inherit;font:inherit;width:100%;min-width:0;padding:0}
+.slab .inp input::placeholder,.slab .ce input::placeholder{color:#52525b}
+.slab .inp:focus-within,.slab .ce:focus-within,.slab .sel2:focus-within{border-color:#6d4cf5}
+.slab .inp.bad,.slab .ce.bad{border-color:#f87171}
+.slab .inp input:disabled{opacity:.5}
+.slab .sel2 select{appearance:none;-webkit-appearance:none;cursor:pointer;height:100%}
+.slab .sel2 select option{background:#0a0a0c;color:#f5f5f7}
+.slab .rin{position:absolute;left:0;top:-13px;width:100%;height:30px;margin:0;opacity:0;cursor:pointer;-webkit-appearance:none;appearance:none;background:transparent}
+.slab .rin::-webkit-slider-thumb{-webkit-appearance:none;width:0;height:30px}
+.slab .rin::-moz-range-thumb{width:0;height:30px;border:0}
+.slab .rng:focus-within .rh{box-shadow:0 0 0 3px rgba(167,139,250,.3)}
+.slab .tin{background:transparent;border:0;outline:0;color:inherit;font:inherit;width:100%;min-width:0;padding:0}
+.slab .btn:disabled{opacity:.5;cursor:not-allowed}
+.slab .btn:focus-visible,.slab .chp:focus-visible,.slab .tgl:focus-visible,.slab .seg3 button:focus-visible{outline:2px solid #a78bfa;outline-offset:2px}
+.slab .errb{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid #4c1d1d;background:#140808;color:#f87171;border-radius:14px;padding:12px 16px;font-size:13px;margin-bottom:16px}
+.slab .errb button{color:#f87171;display:flex}
+.slab .empty{padding:72px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px}
+.slab .empty .t{font-size:16px;font-weight:500;color:#e4e4e7;margin-top:8px}
+.slab .empty .s{font-size:13px;color:#8b8b95;max-width:420px}
+.slab .cs text{font-family:inherit}
+.slab .link{display:flex;align-items:center;gap:6px;cursor:pointer}
+.slab .lnk button{display:flex;align-items:center;gap:6px;color:inherit;font:inherit}
+.slab .drop input[type=file]{display:none}
+.slab .drop{cursor:pointer}
+.slab .ok{font-size:12px;color:#34d399;margin-top:10px}
+.slab .rowbtn{display:flex;gap:10px;margin-top:22px}
+.slab .profs{margin-top:10px;display:flex;flex-direction:column;gap:6px}
+.slab .prof{display:flex;align-items:center;justify-content:space-between;border:1px solid #1f1f23;border-radius:10px;padding:8px 12px;font-size:13px;background:#0a0a0c}
+.slab .prof small{display:block;font-size:11px;color:var(--muted)}
+.slab .prof button{color:#b9a7ff;font-size:12px}
+.slab .prof button.del{color:#f87171;margin-left:12px}
+
+.slab .tbl td{position:relative}
+.slab .tbl .rm{position:absolute;right:-26px;top:50%;transform:translateY(-50%);opacity:0;color:#71717a;display:flex}
+.slab .tbl tr:hover .rm,.slab .tbl tr:focus-within .rm,.slab .tbl .rm:focus-visible{opacity:1}
+@media (hover:none){.slab .tbl .rm{opacity:1}}
+
+.slab .tbl{table-layout:fixed}
+.slab .rl .tin{flex:1}
