diff --git a/frontend/src/styles/sl.css b/frontend/src/styles/sl.css
new file mode 100644
index 0000000..8ed717d
--- /dev/null
+++ b/frontend/src/styles/sl.css
@@ -0,0 +1,162 @@
+/* Generated from the approved redesign mock. Scoped under .sl */
+.slab{--bg:#000;--panel:#0a0a0b;--panel2:#111113;--line:#1c1c20;--text:#f5f5f7;--muted:#8b8b95;--violet:#a78bfa;--lav:#b9a7ff;--coral:#ff4d3d;--green:#34d399;--red:#f87171;color-scheme:dark;background:#000;color:var(--text);font-family:var(--font-inter),Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;-webkit-font-smoothing:antialiased;line-height:normal;min-height:100vh}
+.slab,.slab *{box-sizing:border-box}
+.slab svg{display:inline;vertical-align:baseline}
+.slab sup{vertical-align:super;font-size:smaller;line-height:normal;position:static}
+.slab a{color:inherit;text-decoration:none}
+.slab .dash{display:flex;min-height:100vh}
+.slab .side{position:sticky;top:0;height:100vh;overflow:auto}
+.slab .i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
+.slab .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 26px;border-radius:10px;font-size:15px;font-weight:500;font-family:inherit;cursor:pointer;border:1px solid transparent;white-space:nowrap}
+.slab .coral{background:var(--coral);color:#fff}
+.slab .ghost{background:#0b0b0d;color:#f5f5f7;border-color:#26262a}
+.slab .vio{background:#6d4cf5;color:#fff}
+.slab .lavb{background:var(--lav);color:#17102e}
+.slab .nav{height:86px;display:flex;align-items:center;justify-content:space-between;padding:0 110px;border-bottom:1px solid #121214}
+.slab .logo{display:flex;align-items:center;gap:12px;font-size:23px;font-weight:600;letter-spacing:-.5px}
+.slab .logo i{width:38px;height:38px;border-radius:10px;background:#6d4cf5;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:20px;color:#fff}
+.slab .links{display:flex;gap:44px;font-size:15px;color:#c4c4cc}
+.slab .navr{display:flex;align-items:center;gap:28px;font-size:15px}
+.slab .navr .btn{height:44px;padding:0 24px}
+.slab .hero{text-align:center;padding-top:92px}
+.slab .pill{display:inline-block;font-size:11px;letter-spacing:.6px;color:#b8a6ff;background:#160f33;border:1px solid #2b2058;border-radius:999px;padding:8px 20px;font-weight:500}
